# Copy to .env and fill in. Never commit .env.

PORT=5000
NODE_ENV=development

# Website and API addresses (used for CORS, cookies and social sign-in redirects)
APP_URL=http://localhost:5173
API_URL=http://localhost:5000
CORS_ORIGIN=

# Session signing secret: 32+ random characters. Required in production.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Business contact form email
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# Mobile sign-in SMS provider (e.g. msg91, twilio). Empty in development = every code is 123456.
SMS_PROVIDER=

# Social sign-in. Each button turns on once its id and secret are set.
# Redirect URI to register with each provider: {API_URL}/api/auth/oauth/{google|facebook|instagram}/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# Instagram Login works for Instagram business and creator accounts only.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
