// Production user store for PIAX sign-in (replaces the development JSON store in auth/userStore.js).
// Not yet migrated: set DATABASE_URL, then run `npx prisma migrate dev`.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  BUSINESS
  ADMIN
}

model User {
  id            String         @id @default(uuid())
  name          String         @default("")
  email         String?        @unique
  emailVerified Boolean        @default(false)
  phone         String?        @unique
  passwordHash  String?
  role          Role           @default(CUSTOMER)
  tokenVersion  Int            @default(0)
  createdAt     DateTime       @default(now())
  lastLoginAt   DateTime       @default(now())
  oauthAccounts OAuthAccount[]
  reviews       Review[]
  comments      ReviewComment[]
  helpfulVotes  ReviewHelpful[]
}

// One row per linked Google / Facebook / Instagram account.
model OAuthAccount {
  id         String @id @default(uuid())
  provider   String
  providerId String
  user       User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String

  @@unique([provider, providerId])
  @@index([userId])
}

// Product reviews (backend/reviews). One review per person per product; `verified` is set once a delivered
// order for that product can be matched to the reviewer.
model Review {
  id        String          @id @default(uuid())
  productId String
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  rating    Int
  title     String          @default("")
  body      String
  wear      String?
  flow      String?
  verified  Boolean         @default(false)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  comments  ReviewComment[]
  helpful   ReviewHelpful[]

  @@unique([productId, userId])
  @@index([productId])
}

model ReviewComment {
  id        String   @id @default(uuid())
  review    Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  reviewId  String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  body      String
  createdAt DateTime @default(now())

  @@index([reviewId])
}

model ReviewHelpful {
  review   Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  reviewId String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId   String

  @@id([reviewId, userId])
}
